{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cyrene.dev/echo/product/v1/evaluation-run.schema.json",
  "title": "Echo EvaluationRun v1",
  "type": "object",
  "required": [
    "id",
    "suiteId",
    "state",
    "inputArtifact",
    "engineBindingId",
    "createdAt",
    "updatedAt",
    "resourceVersion"
  ],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "suiteId": {"type": "string", "format": "uuid"},
    "state": {"enum": ["RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"]},
    "inputArtifact": {"$ref": "#/$defs/artifactRef"},
    "engineBindingId": {"type": "string", "minLength": 1, "maxLength": 200},
    "resultId": {"type": "string", "format": "uuid"},
    "gateId": {"type": "string", "format": "uuid"},
    "failure": {"$ref": "#/$defs/failure"},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "resourceVersion": {"type": "integer", "minimum": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "SUCCEEDED"}}},
      "then": {"required": ["resultId", "gateId"]}
    },
    {
      "if": {"properties": {"state": {"const": "FAILED"}}},
      "then": {"required": ["failure"]}
    }
  ],
  "$defs": {
    "artifactRef": {
      "$comment": "SPDX-License-Identifier: Apache-2.0",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://cy-llm.dev/schemas/manifests/artifact_ref.schema.json",
      "title": "ArtifactRef",
      "description": "Provider-neutral immutable reference to an artifact. Provider locations are resolved separately.",
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest", "size_bytes", "kind"],
      "properties": {
        "uri": {"type": "string", "pattern": "^artifact://sha256/[0-9a-f]{64}$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Opaque producer-owned category. Platform does not define its vocabulary."
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Digest of a canonical multi-file directory index when the artifact is a directory; for a portable V2 directory this identifies the manifest bytes described by portable_directory_manifest.schema.json."
        }
      }
    },
    "failure": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "retryable": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
